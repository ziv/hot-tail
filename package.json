{
  "name": "afterburner",
  "private": true,
  "version": "0.4.1",
  "description": "Hot Tail \u2014 arcade-speed jet combat shooter for the web",
  "type": "module",
  "packageManager": "pnpm@10.14.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/compress.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "ci": "pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "balance": "BALANCE=1 vitest run tests/balance.test.ts",
    "icons": "node scripts/make-icons.mjs",
    "build:vercel": "node scripts/build-vercel.mjs",
    "dev:api": "node scripts/dev-api.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.117.2",
    "lil-gui": "^0.21.0",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.8",
    "@eslint/js": "^10.0.0",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.0.0",
    "@types/three": "^0.186.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "globals": "^16.0.0",
    "prettier": "^3.9.9",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
